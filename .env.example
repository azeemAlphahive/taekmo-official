# Railway Postgres — paste the public DATABASE_URL from your Railway project.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Admin panel login (/admin/login) — keep private, do not share publicly
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-strong-password"
ADMIN_SESSION_SECRET="long-random-string-for-jwt-signing"

# Optional: CLI / script header auth for POST /api/admin/import-pdf
ADMIN_IMPORT_SECRET="change-me"
