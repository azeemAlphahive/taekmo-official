{
  "expo": {
    "name": "TAEKMO Solar",
    "slug": "taekmo-solar",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "taekmo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101217"
    },
    "androidStatusBar": {
      "backgroundColor": "#101217",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taekmosolar.app",
      "infoPlist": {
        "NSCameraUsageDescription": "TAEKMO uses the camera to scan product barcodes for authenticity verification.",
        "NSPhotoLibraryUsageDescription": "TAEKMO may access photos when you share product images."
      }
    },
    "android": {
      "package": "com.taekmosolar.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#101217"
      },
      "permissions": [
        "CAMERA",
        "INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "TAEKMO uses the camera to scan product barcodes for authenticity verification.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101217",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 280
        }
      ],
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://taekmo-official.com",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e2b51e8d-92cf-4eca-9bfa-f414a3faa330"
      }
    },
    "owner": "azeem7474"
  }
}
